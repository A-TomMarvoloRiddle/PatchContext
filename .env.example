# REQUIRED 
OPENAI_API_KEY=sk-...
GITHUB_TOKEN=ghp_...

# GitHub
GITHUB_REPO=tiangolo/fastapi

# OpenAI
EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# FAISS index output directory
FAISS_INDEX_DIR=./indexes/fastapi

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200
SHORT_DOC_THRESHOLD=600

# MMR retriever
MMR_K=6
MMR_FETCH_K=20
MMR_LAMBDA_MULT=0.65

# NLI guard
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_ENABLED=true

# Ingestion rate-limit caps
MAX_COMMITS=500
MAX_PRS=300
MAX_ISSUES=300

# Benchmark
BENCHMARK_FILE=./data/benchmark.json
