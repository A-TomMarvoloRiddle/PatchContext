# REQUIRED 
GROQ_API_KEY=gsk_...
GITHUB_TOKEN=ghp_...

# LLM Configuration (Groq Llama 3.3 70B) 
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0

# Embeddings (Free local HuggingFace or OpenAI) 
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# GitHub 
GITHUB_REPO=tiangolo/fastapi

# FAISS Index output directory
FAISS_INDEX_DIR=./indexes/fastapi

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200
SHORT_DOC_THRESHOLD=600

# MMR retriever
MMR_K=6
MMR_FETCH_K=20
MMR_LAMBDA_MULT=0.65

# NLI guard
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_ENABLED=true

# Ingestion rate-limit caps
MAX_COMMITS=500
MAX_PRS=300
MAX_ISSUES=300

# Benchmark
BENCHMARK_FILE=./data/benchmark.json
